# Copy to .env (never commit .env) and fill in.
BOT_TOKEN=
# Optional: comma-separated Telegram user IDs allowed to use the bot. Leave empty to allow everyone.
ALLOWED_USERS=
# Optional: inline Netscape cookies.txt content or a path to the file
COOKIES_FILE=
# Optional tuning
MAX_FILE_SIZE_MB=50
COOLDOWN_SECONDS=5
DOWNLOAD_TIMEOUT=1800
MAX_CONCURRENT_JOBS=2
MAX_PLAYLIST_ITEMS=10
# Instagram profile scan + bulk download (send a profile link to the bot)
PROFILE_SCAN_LIMIT=500
PROFILE_SCAN_SLEEP=3.0-6.0
PROFILE_PAUSE_SECONDS=2
PROFILE_FAIL_STREAK=5
