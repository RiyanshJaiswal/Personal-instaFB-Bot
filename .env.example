# Copy to .env (never commit .env) and fill in.
BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USERS=
# Optional: inline Netscape cookies.txt content or a path to the file
COOKIES_FILE=
# Optional tuning
MAX_FILE_SIZE_MB=50
COOLDOWN_SECONDS=5
DOWNLOAD_TIMEOUT=1800
MAX_CONCURRENT_JOBS=2
MAX_PLAYLIST_ITEMS=10
